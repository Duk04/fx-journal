datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String         @map("password_hash")
  createdAt    DateTime       @default(now()) @map("created_at")

  trades         Trade[]
  sessions       Session[]
  journalEntries JournalEntry[]
  templates      TradeTemplate[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    Int      @map("user_id")
  username  String
  expiresAt DateTime @map("expires_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Trade {
  id            Int       @id @default(autoincrement())
  userId        Int?      @map("user_id")
  pair          String
  direction     String
  entryPrice    Float     @map("entry_price")
  exitPrice     Float?    @map("exit_price")
  lotSize       Float     @map("lot_size")
  sl            Float?
  tp            Float?
  openedAt      DateTime  @map("opened_at")
  closedAt      DateTime? @map("closed_at")
  pnl           Float?
  rr            Float?
  notes         String?
  plan          String?
  tags          String    @default("[]")
  screenshotUrl String?   @map("screenshot_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  user     User?          @relation(fields: [userId], references: [id])
  journal  JournalEntry[]
  analysis AnalysisCache?

  @@map("trades")
}

model JournalEntry {
  id        Int      @id @default(autoincrement())
  tradeId   Int?     @map("trade_id")
  userId    Int?     @map("user_id")
  content   String
  mood      String?
  createdAt DateTime @default(now()) @map("created_at")

  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id])

  @@map("journal_entries")
}

model AnalysisCache {
  tradeId  Int      @id @map("trade_id")
  result   String
  cachedAt DateTime @map("cached_at")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("analysis_cache")
}

model TradeTemplate {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  pair      String
  direction String
  lotSize   Float?   @map("lot_size")
  sl        Float?
  tp        Float?
  tags      String   @default("[]")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trade_templates")
}
